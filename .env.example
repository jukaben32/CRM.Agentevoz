# ── Base de datos ───────────────────────────────────────────────
# Estas tres variables las consume docker-compose para inicializar el motor Postgres 18.
POSTGRES_USER=voiceops
POSTGRES_PASSWORD=voiceops_dev_pass
POSTGRES_DB=voiceops

# Configuración de conexión para la aplicación y scripts.
# En desarrollo: DB_HOST=localhost; en Dokploy (producción): DB_HOST=db
DB_HOST=localhost
DB_PORT=5432

# Rol de aplicación (sin BYPASSRLS ni SUPERUSER) con el que se conecta el runtime web.
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user_dev_pass

# ── Aplicación ──────────────────────────────────────────────────
# En desarrollo: URL de Tailscale Funnel (https://<equipo>.<tailnet>.ts.net).
# En producción: https://<tu-dominio.com>
APP_URL=http://localhost:3000

# Solo para producción en Dokploy / Traefik: nombre de dominio sin protocolo.
# En desarrollo se puede dejar vacío.
APP_DOMAIN=

# ── VAPI (Plataforma de Voz) ────────────────────────────────────
# Clave privada de API de VAPI. Jamás exponer al cliente ni prefijar con NEXT_PUBLIC_.
VAPI_API_KEY=

# ID de la Custom Credential Bearer creada en el dashboard de VAPI (Dashboard > Custom Credentials).
VAPI_SERVER_CREDENTIAL_ID=

# Token Bearer secreto que viaja en la cabecera 'Authorization: Bearer <token>' configurada en dicha credencial.
VAPI_WEBHOOK_TOKEN=

# ── Localización & CRM ──────────────────────────────────────────
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_COUNTRY_CODE=ES
